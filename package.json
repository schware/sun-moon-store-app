{
  "name": "sun-moon-store-app",
  "version": "0.1.0",
  "private": true,
  "description": "매장 단말 셸 — POS · KDS-MAIN (· KIOSK). umbrella docs/design/store-app.md §5",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-setup.mjs",
    "ui": "node scripts/bundle-ui.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "dist": "npm run build && npm run ui && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.sunmoon.storeapp",
    "productName": "SunMoon Store",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "ui",
        "to": "ui"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
